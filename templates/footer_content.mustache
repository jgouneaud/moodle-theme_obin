{{!
    @template theme_obin/footer_content

    Pied de page visible du thème OBIN.

    Context variables required for this template:
    * sitename - Nom du site
    * tagline - Accroche optionnelle
    * email - E-mail de contact optionnel
    * links - Tableau de {label, url}
    * year - Année en cours (copyright)
}}
<footer class="obin-footer d-print-none">
    <div class="obin-footer-inner">
        <img src="{{moodlelogourl}}" alt="Moodle" class="obin-footer-moodlelogo">
        <nav class="obin-footer-links" aria-label="{{#str}}pluginname, theme_obin{{/str}}">
            {{#links}}
                <a href="{{url}}">{{label}}</a>
            {{/links}}
            {{#email}}
                <a href="mailto:{{email}}">{{email}}</a>
            {{/email}}
            <a href="https://download.moodle.org/mobile/" target="_blank" rel="noopener">📱 Version mobile</a>
        </nav>
        <div class="obin-footer-copyright">
            © {{year}} {{sitename}}
        </div>
        <button id="openHaOverlay" class="obin-donate-btn">❤️ Je soutiens le Theme OBIN pour Moodle</button>
    </div>
</footer>

<div id="haWidgetModal" style="position: fixed; inset: 0; display: none; align-items: center; justify-content: center; backdrop-filter: blur(15px) brightness(0.5); z-index: 2147483647;">
    <button id="closeHaWidgetBtn" style="position: absolute; top: .5rem; right: 1.5rem; z-index: 2147483648; background: #EFEFF4; border: none; border-radius: 50%; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <div class="modal-content" style="position: relative; width: 100%; max-width: 950px; height: 100%; overflow: hidden;">
      <iframe
        id="haWidget"
        src="https://www.helloasso.com/associations/citoyennete-et-inclusion-numerique-obin/formulaires/4/widget?view=overlay"
        style="width: 100%; height: 100%; border: none; border-radius: 8px;"
      ></iframe>
    </div>
</div>
<script>
(function() {
    var openBtn = document.getElementById('openHaOverlay');
    var closeBtn = document.getElementById('closeHaWidgetBtn');
    var modal = document.getElementById('haWidgetModal');
    if (!openBtn || !modal) {
        return;
    }
    openBtn.addEventListener('click', function() {
        modal.style.display = 'flex';
    });
    if (closeBtn) {
        closeBtn.addEventListener('click', function() {
            modal.style.display = 'none';
        });
    }
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            modal.style.display = 'none';
        }
    });
})();
</script>
